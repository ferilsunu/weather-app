<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="Luxury Minimalist Light Weather Platform by Feril Sunu">
  <title>Weather App • Feril Sunu</title>

  <!-- Leaflet Map CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

  <!-- App Styles -->
  <link rel="stylesheet" href="/css/style.css?v=5.0.0">
  <link rel="icon" type="image/png" href="/img/pin.png?v=2.2.0">
</head>

<body class="mode-2026">
  <!-- Dynamic Atmospheric Background Canvas -->
  <canvas id="weather-canvas" class="weather-canvas"></canvas>
  <div class="sky-ambient-glow"></div>

  <!-- Sticky Luxury Header -->
  <header class="app-header">
    <div class="header-inner">
      <div class="brand-group">
        <div class="brand-logo-icon" title="Weather App">
          <svg class="brand-logo-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
            <path d="M12 12v3"></path>
            <path d="m9 15 3 3 3-3"></path>
          </svg>
        </div>
        <div class="brand-titles">
          <span class="brand-name">WEATHER APP</span>
          <span class="brand-sub">FERIL SUNU</span>
        </div>
      </div>

      <!-- Center: 2020 vs 2026 Toggle Switch -->
      <div class="era-switcher-wrap" role="group" aria-label="Version Switcher">
        <button type="button" class="era-toggle-btn" id="btn-mode-2020" data-mode="2020">
          <span>2020</span>
          <small>VINTAGE</small>
        </button>
        <button type="button" class="era-toggle-btn active" id="btn-mode-2026" data-mode="2026">
          <svg class="sparkle-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
          </svg>
          <span>2026</span>
          <small>NEXTGEN</small>
        </button>
        <div class="era-active-pill"></div>
      </div>

      <!-- Right Controls -->
      <div class="header-actions">
        <button type="button" id="btn-unit-toggle" class="glass-btn pill-btn" title="Toggle °C / °F">
          <span id="unit-label">°C</span>
        </button>
        <button type="button" id="btn-sound-toggle" class="glass-btn icon-btn" title="Ambient Weather Audio">
          <span id="sound-icon-wrap">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </header>

  <!-- ========================================== -->
  <!-- 1. 2020 VINTAGE CONTAINER                  -->
  <!-- ========================================== -->
  <main id="view-2020" class="view-panel">
    <div class="vintage-wrapper">
      {{>header}}

      <div id="weather-box">
        <div id="location">
          <svg class="vintage-pin-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <p id="place">--</p>
        </div>
        <p id="temp">Type Your Location Below</p>
      </div>

      <div id="searchbox">
        <form id="form-2020">
          <input type="text" id="input-2020" placeholder="Enter Location" autocomplete="off" spellcheck="false">
          <input type="submit" id="submit_button" value="Search">
        </form>
      </div>

      {{>footer}}
    </div>
  </main>

  <!-- ========================================== -->
  <!-- 2. 2026 NEXTGEN CONTAINER                  -->
  <!-- ========================================== -->
  <main id="view-2026" class="view-panel active">
    <div class="nextgen-container">

      <!-- Search & Autocomplete Section -->
      <section class="search-section">
        <div class="search-bar-glass">
          <svg class="search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="input-2026" placeholder="Search city or coordinates (e.g. Dubai, London, Tokyo)..." autocomplete="off" spellcheck="false">
          <button type="button" id="btn-geo-detect" class="geo-btn" title="Use My Current GPS Location" aria-label="Locate me">
            <svg class="geo-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="2" y1="12" x2="5" y2="12"></line>
              <line x1="19" y1="12" x2="22" y2="12"></line>
              <line x1="12" y1="2" x2="12" y2="5"></line>
              <line x1="12" y1="19" x2="12" y2="22"></line>
              <circle cx="12" cy="12" r="7"></circle>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>

          <!-- Autocomplete Dropdown List with Top Z-Index -->
          <div id="autocomplete-list" class="autocomplete-dropdown"></div>
        </div>

        <!-- Quick City Filter Pills -->
        <div class="city-pills-row" id="quick-cities">
          <button type="button" class="city-pill" data-city="Dubai">Dubai</button>
          <button type="button" class="city-pill" data-city="London">London</button>
          <button type="button" class="city-pill" data-city="Tokyo">Tokyo</button>
          <button type="button" class="city-pill" data-city="New York">New York</button>
          <button type="button" class="city-pill" data-city="Singapore">Singapore</button>
          <button type="button" class="city-pill" data-city="Paris">Paris</button>
          <button type="button" class="city-pill" data-city="Sydney">Sydney</button>
        </div>
      </section>

      <!-- Primary Weather Dashboard Grid -->
      <div class="weather-dashboard-layout">

        <!-- Main Column (Hero, Hourly, 7-Day) -->
        <div class="layout-main">

          <!-- 1. Hero Atmospheric Showcase Card -->
          <div class="obsidian-card hero-showcase" id="hero-card">
            <div class="hero-header-row">
              <div class="hero-location-info">
                <div class="city-flag-group">
                  <h1 id="hero-city">Dubai</h1>
                  <span id="hero-country-badge" class="country-badge">AE</span>
                </div>
                <div class="location-subtext">
                  <span id="hero-local-time">--:--</span>
                  <span class="dot-sep">•</span>
                  <span id="hero-coords">25.20°N, 55.27°E</span>
                </div>
              </div>
              <div class="live-status-pill">
                <span class="live-dot"></span>
                <span>TELEMETRY LIVE</span>
              </div>
            </div>

            <div class="hero-center-row">
              <div class="hero-temp-col">
                <div class="hero-temp-huge">
                  <span id="hero-temp">36</span><span class="degree-mark">°</span>
                </div>
                <div class="hero-condition-desc" id="hero-condition">Clear Sky</div>
                <div class="hero-range-desc">
                  <span>Feels like <strong id="hero-feels-like">40°</strong></span>
                  <span class="dot-sep">•</span>
                  <span id="hero-min-max">H: 38° L: 28°</span>
                </div>
              </div>

              <div class="hero-art-col">
                <div class="weather-vector-glyph" id="hero-glyph-box">
                  <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                  </svg>
                </div>
              </div>
            </div>

            <div class="hero-quick-stats">
              <div class="q-stat">
                <div class="q-stat-hdr">
                  <svg class="q-stat-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
                    <path d="M16 14v6"></path>
                    <path d="M8 14v6"></path>
                    <path d="M12 16v6"></path>
                  </svg>
                  <span class="q-label">PRECIPITATION</span>
                </div>
                <span class="q-val" id="hero-precip-stat">0%</span>
              </div>
              <div class="q-stat">
                <div class="q-stat-hdr">
                  <svg class="q-stat-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"></path>
                    <path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"></path>
                  </svg>
                  <span class="q-label">HUMIDITY</span>
                </div>
                <span class="q-val" id="hero-humidity-stat">48%</span>
              </div>
              <div class="q-stat">
                <div class="q-stat-hdr">
                  <svg class="q-stat-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"></path>
                    <path d="M9.6 4.6A2 2 0 1 1 11 8H2"></path>
                    <path d="M12.6 19.4A2 2 0 1 0 14 16H2"></path>
                  </svg>
                  <span class="q-label">WIND SPEED</span>
                </div>
                <span class="q-val" id="hero-wind-stat">14 km/h</span>
              </div>
              <div class="q-stat">
                <div class="q-stat-hdr">
                  <svg class="q-stat-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                  </svg>
                  <span class="q-label">UV INDEX</span>
                </div>
                <span class="q-val" id="hero-uv-stat">8 Very High</span>
              </div>
            </div>
          </div>

          <!-- 2. Hourly Forecast Carousel -->
          <div class="obsidian-card hourly-panel">
            <div class="card-title-row">
              <div class="title-with-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>24-HOUR HOURLY TRAJECTORY</span>
              </div>
              <span class="mini-tag">CHRONO</span>
            </div>
            <div class="hourly-slider-track" id="hourly-deck">
              <!-- Hourly Cards dynamically injected -->
            </div>
          </div>

          <!-- 3. 7-Day Extended Forecast -->
          <div class="obsidian-card daily-panel">
            <div class="card-title-row">
              <div class="title-with-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                <span>7-DAY EXTENDED OUTLOOK</span>
              </div>
              <span class="mini-tag">ENSEMBLE</span>
            </div>
            <div class="daily-rows-wrap" id="daily-deck">
              <!-- Daily Rows dynamically injected -->
            </div>
          </div>

        </div>

        <!-- Sidebar Column (Diagnostics Matrix, AI Briefing, Radar Map) -->
        <div class="layout-side">

          <!-- Diagnostic Metrics Grid -->
          <div class="diagnostics-mosaic">

            <!-- Card 1: Air Quality Index -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">AIR QUALITY (AQI)</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"></path>
                    <path d="M9.6 4.6A2 2 0 1 1 11 8H2"></path>
                    <path d="M12.6 19.4A2 2 0 1 0 14 16H2"></path>
                  </svg>
                </span>
              </div>
              <div class="diag-body">
                <div class="aqi-main-val">
                  <span class="big-num" id="aqi-value">28</span>
                  <span class="aqi-badge good" id="aqi-category">Good</span>
                </div>
                <div class="color-track-bar">
                  <div class="color-track-fill" id="aqi-bar-fill" style="width: 25%;"></div>
                </div>
                <div class="aqi-submetrics">
                  <span id="aqi-pm25">PM2.5: 8.5 µg/m³</span>
                  <span id="aqi-pm10">PM10: 15.2 µg/m³</span>
                </div>
              </div>
            </div>

            <!-- Card 2: UV Index -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">UV RADIATION</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                  </svg>
                </span>
              </div>
              <div class="diag-body">
                <div class="aqi-main-val">
                  <span class="big-num" id="uv-value">6</span>
                  <span class="aqi-badge mod" id="uv-category">Moderate</span>
                </div>
                <div class="color-track-bar">
                  <div class="color-track-fill" id="uv-bar-fill" style="width: 55%;"></div>
                </div>
                <p class="diag-hint" id="uv-advice">Sun protection recommended.</p>
              </div>
            </div>

            <!-- Card 3: Wind & Compass -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">WIND TELEMETRY</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                  </svg>
                </span>
              </div>
              <div class="diag-body wind-diag-body">
                <div class="mini-compass-frame">
                  <div class="compass-rose-circle">
                    <span class="comp-n">N</span>
                    <span class="comp-e">E</span>
                    <span class="comp-s">S</span>
                    <span class="comp-w">W</span>
                    <div class="compass-pointer-arrow" id="compass-needle"></div>
                  </div>
                </div>
                <div class="wind-readouts">
                  <div class="big-num-sm" id="wind-speed">14 <small>km/h</small></div>
                  <div class="sub-line" id="wind-direction">Direction: 120°</div>
                  <div class="sub-line" id="wind-gusts">Gusts: 22 km/h</div>
                </div>
              </div>
            </div>

            <!-- Card 4: Sunrise / Sunset Solar Arc -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">SOLAR CYCLE</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v8"></path>
                    <path d="m4.93 10.93 1.41 1.41"></path>
                    <path d="M2 18h2"></path>
                    <path d="M20 18h2"></path>
                    <path d="m19.07 10.93-1.41 1.41"></path>
                    <path d="M22 22H2"></path>
                    <path d="m8 6 4-4 4 4"></path>
                    <path d="M16 18a4 4 0 0 0-8 0"></path>
                  </svg>
                </span>
              </div>
              <div class="diag-body">
                <div class="solar-arc-box">
                  <svg viewBox="0 0 120 50" class="solar-path-svg">
                    <path d="M 10,45 Q 60,5 110,45" fill="none" stroke="rgba(0,0,0,0.15)" stroke-width="2" stroke-dasharray="3,3" />
                    <circle id="sun-orb" cx="60" cy="15" r="5" fill="#000000" filter="drop-shadow(0 0 4px rgba(0,0,0,0.3))" />
                  </svg>
                </div>
                <div class="sun-times-row">
                  <div>
                    <span class="lbl">Sunrise</span>
                    <strong id="sunrise-time">06:12</strong>
                  </div>
                  <div>
                    <span class="lbl">Sunset</span>
                    <strong id="sunset-time">18:25</strong>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card 5: Humidity & Dew Point -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">HUMIDITY</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"></path>
                    <path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"></path>
                  </svg>
                </span>
              </div>
              <div class="diag-body">
                <div class="big-num" id="humidity-value">48%</div>
                <div class="humidity-details">
                  <span>Dew point: <strong id="dew-point-val">19°</strong></span>
                  <span class="badge-sub" id="humidity-comfort">Comfortable</span>
                </div>
              </div>
            </div>

            <!-- Card 6: Lunar Phase -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">MOON PHASE</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                  </svg>
                </span>
              </div>
              <div class="diag-body moon-diag-body">
                <div class="moon-large-glyph" id="moon-glyph">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                  </svg>
                </div>
                <div class="moon-info-lines">
                  <strong class="moon-title-text" id="moon-name">Full Moon</strong>
                  <span class="sub-line" id="moon-illum">98% Illumination</span>
                </div>
              </div>
            </div>

            <!-- Card 7: Precipitation -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">PRECIPITATION</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
                    <path d="M16 14v6"></path>
                    <path d="M8 14v6"></path>
                    <path d="M12 16v6"></path>
                  </svg>
                </span>
              </div>
              <div class="diag-body">
                <div class="big-num" id="precip-val">0.0 <small>mm</small></div>
                <p class="diag-hint" id="precip-prob">0% chance in next 24h</p>
              </div>
            </div>

            <!-- Card 8: Pressure -->
            <div class="obsidian-card diag-card">
              <div class="diag-header">
                <span class="diag-title">PRESSURE</span>
                <span class="diag-icon">
                  <svg class="diag-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 14 4-4"></path>
                    <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
